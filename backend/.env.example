# ============ 复制为 .env 后填写真实值 ============

# ---------- 应用 ----------
DEBUG=true

# ---------- 数据库（与 docker-compose.yml 保持一致）----------
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/gapscout

# ---------- LLM（DeepSeek，兼容 OpenAI 协议）----------
DEEPSEEK_API_KEY=REPLACE_WITH_YOUR_KEY
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL_MAIN=deepseek-reasoner
LLM_MODEL_CHEAP=deepseek-chat

# ---------- 嵌入模型 ----------
# 不配置 API 时自动使用本地 sentence-transformers（需安装 embed 组：pip install -e ".[embed]"）
# 三级降级：远程 API -> 本地语义模型 -> TF-IDF（未安装 embed 组时直接落到 TF-IDF）
EMBED_API_KEY=
EMBED_BASE_URL=
EMBED_MODEL=BAAI/bge-small-en-v1.5
# 首次运行需下载模型。无法直连 huggingface.co 时配置国内镜像，例如 https://hf-mirror.com
HF_ENDPOINT=
# 说明：嵌入维度由 app/config.py 的模块常量 EMBED_DIM 决定（当前 384，对应 bge-small-en-v1.5），
# 不作为环境变量读取。若换成 bge-m3 等多语言模型（1024 维），需同时修改该常量并重建 paper.embedding 列。

# ---------- 数据源 ----------
# 携带真实邮箱可进入 arXiv / OpenAlex 礼貌池，降低被限流概率
CONTACT_EMAIL=your_email@example.com
# Semantic Scholar 可选，申请后限流更宽松
S2_API_KEY=

# ---------- 跨域 ----------
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# ============ 以下为高级参数，均有合理默认值，一般无需修改 ============
# 如需调整，去掉行首的 # 即可生效（未被注释的参数名与环境变量名一一对应，不区分大小写）

# ---- 数据库 ----
# DB_ECHO=false

# ---- LLM 调用 ----
# LLM_TIMEOUT=180.0
# LLM_MAX_RETRIES=3
# LLM_MAX_CONCURRENCY=4

# ---- 嵌入 ----
# EMBED_BATCH_SIZE=32
# EMBED_MAX_CONCURRENCY=2

# ---- 数据源限流与超时（秒）----
# ARXIV_MIN_INTERVAL=5.0
# OPENALEX_MIN_INTERVAL=0.15
# S2_MIN_INTERVAL=0.5
# HTTP_TIMEOUT=40.0

# ---- 检索规模 ----
# DEFAULT_SEARCH_LIMIT_PER_SOURCE=200
# MIN_YEAR=2019

# ---- 全文抓取 ----
# FULLTEXT_CONCURRENCY=8
# FULLTEXT_MIN_INTERVAL=0.25

# ---- 聚类 ----
# CLUSTER_MIN_SIZE=6
# CLUSTER_MERGE_SIMILARITY=0.85
# REDUCE_DIM=5
